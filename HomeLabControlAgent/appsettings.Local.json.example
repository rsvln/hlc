{
  // Скопировать рядом с HomeLabControlAgent(.exe) как appsettings.Local.json.
  // Ключ генерируется командой: HomeLabControlAgent --generate-key
  // Один ключ на машину: с ним ходят HomeLabControl и Home Assistant (заголовок X-Api-Key).
  // Можно добавить и другие ключи — имя клиента попадает в логи ("Shutdown requested by homelabcontrol"), ключ нет.
  "Auth": {
    "ApiKeys": {
      "homelabcontrol": "ЗАМЕНИТЬ-на-сгенерированный-ключ"
    }
  }
}
