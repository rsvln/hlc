{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "HomeLabControlAgent": "Information"
    }
  },
  "AllowedHosts": "*",
  "ServicePort": 8117,
  "ProfilesFilePath": "profiles.json",
  "FanControl": {
    "ReapplyIntervalSeconds": 30
  },
  "SmartMonitor": {
    "ScanIntervalSeconds": 300
  },
  "Metrics": {
    "Anonymous": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Auth": {
    "Enabled": true,
    "ApiKeys": {}
  }
}
