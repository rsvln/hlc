<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <AssemblyName>HomeLabControlAgent</AssemblyName>
    <RootNamespace>HomeLabControlAgent</RootNamespace>
    <!-- Агенту не нужны культурные данные: без этого self-contained сборка требует libicu на хосте -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Без de-DE / es-ES и т.п. (локализованные ресурсы DiskInfoToolkit из LibreHardwareMonitorLib) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- pdb внутри dll: номера строк в стектрейсах остаются, лишнего файла нет -->
    <DebugType>embedded</DebugType>
    <!-- Статики нет (Swagger UI — встроенные ресурсы), *.staticwebassets.endpoints.json не нужен -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- web.config нужен только для IIS -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre744" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Windows Service / Linux Systemd -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />

    <!-- Математика для кривых -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />

    <!-- Парсинг custom формул -->
    <PackageReference Include="NCalcSync" Version="7.2.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <!-- profiles.json и appsettings.Local.json — локальное состояние конкретной машины,
       в publish не попадают, чтобы деплой их не перезатирал -->
  <ItemGroup>
    <Content Remove="profiles.json;appsettings.Local.json" />
    <None Remove="profiles.json;appsettings.Local.json" />
    <!-- Только для запуска из IDE -->
    <Content Update="appsettings.Development.json;dotnet-tools.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Скрипты ручной установки: в сборку своей ОС -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <None Include="install\install.ps1;install\install.cmd" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="install\install.sh" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- При публикации под Windows кладём рядом ShutdownDialog.exe (нужен для *-with-dialog).
       EnableWindowsTargeting — чтобы WinForms-проект собирался и в Linux-контейнере (Dockerfile HomeLabControl). -->
  <Target Name="PublishShutdownDialog" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\ShutdownDialog\ShutdownDialog.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) -p:SelfContained=$([MSBuild]::ValueOrDefault('$(SelfContained)', 'false')) -p:EnableWindowsTargeting=true -o &quot;$(PublishDir)&quot;" />
  </Target>

</Project>
