    private void OpenRelaySetup(WolRelay r)
    {
        setupRelay = r;
        setupPassword = null;
        setupResult = null;
    }

    private async Task RunRelaySetup()
    {
        await Auth.RequireAsync(Policies.Admin);
        setupBusy = true;
        setupResult = new DeployResult { Message = "Setting up…" };
        StateHasChanged();

        // Живой лог, пока идёт настройка (opkg update бывает долгим)
        using var timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        try
        {
            await Relays.SetupAsync(setupRelay!, setupPassword, setupResult);
            await Auth.AuditAsync("power.relay.setup", setupRelay!.Name, setupResult.Message, setupResult.Success);
        }
        finally
        {
            setupPassword = null;
            setupBusy = false;
        }
    }

    // ─── Power Control Actions ────────────────────────────────────────────────

    private async Task Wol(string mac)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        var host = PowerService.GetHosts().FirstOrDefault(h => string.Equals(h.Mac, mac, StringComparison.OrdinalIgnoreCase));
        await Auth.RequireHostAsync(host?.Name ?? mac);
        var (success, via) = host != null ? await PowerService.WakeAsync(host) : (await PowerService.WakeOnLanAsync(mac), "local broadcast");
        await Auth.AuditAsync("power.wol", host?.Name ?? mac, via, success);
        ShowMessage(
            success ? $"WOL packet sent ({via})" : $"WOL failed: {via}",
            success ? "success" : "error");
    }

    private async Task Shutdown(string ip, int port, string hostName, bool withDialog)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        await Auth.RequireHostAsync(hostName);
        var delay = delayValues[hostName];
        var success = await PowerService.ShutdownAsync(ip, port, delay, withDialog);
        await Auth.AuditAsync("power.shutdown", hostName, $"delay={delay}s{(withDialog ? ", dialog" : "")}", success);

        if (success)
        {
            StartCountdown(hostName, delay);
            ShowMessage($"Shutdown initiated for {hostName}", "success");
        }
        else
        {
            ShowMessage($"Shutdown failed for {hostName}", "error");
        }
    }

