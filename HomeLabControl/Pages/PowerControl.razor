    private string WolTitle(HostModel host)
    {
        if (string.IsNullOrWhiteSpace(host.Mac))
            return "No MAC in the config";
        var relay = Relays.Resolve(host);
        return relay == null ? "Wake-on-LAN (broadcast from HLC's network)" : $"Wake-on-LAN via relay {relay.Name} ({Relays.Describe(relay)})";
    }

    private void NewRelay()
    {
        relayError = null;
        relayEditOriginal = null;
        relayEdit = new WolRelay { Type = WolRelay.Ssh };
    }

    private void EditRelay(WolRelay r)
    {
        relayError = null;
        relayEditOriginal = r.Name;
        relayEdit = new WolRelay
        {
            Name = r.Name, Subnet = r.Subnet, Type = r.Type, Host = r.Host, Address = r.Address,
            SshUser = r.SshUser, SshPort = r.SshPort, Interface = r.Interface
        };
    }

    private async Task SaveRelay()
    {
        await Auth.RequireAsync(Policies.Admin);
        relayError = null;

        var r = relayEdit!;
        r.Name = r.Name.Trim();
        r.Subnet = r.Subnet.Trim();
        if (r.Type == WolRelay.Agent)
        {
            r.Address = null; r.SshUser = null; r.SshPort = null; r.Interface = null;
        }
        else
        {
            r.Host = null;
            r.Address = string.IsNullOrWhiteSpace(r.Address) ? null : r.Address.Trim();
            r.SshUser = string.IsNullOrWhiteSpace(r.SshUser) || r.SshUser.Trim() == "root" ? null : r.SshUser.Trim();
            r.SshPort = r.SshPort is null or 22 ? null : r.SshPort;
            r.Interface = string.IsNullOrWhiteSpace(r.Interface) || r.Interface.Trim() == "br-lan" ? null : r.Interface.Trim();
        }
        if (string.IsNullOrEmpty(r.Host))
            r.Host = null;

        try
        {
            await ConfigService.SaveWolRelayAsync(relayEditOriginal, r);
            await Auth.AuditAsync("power.relay.save", r.Name, $"{r.Subnet}, {Relays.Describe(r)}");
            relayEdit = null;
            LoadData();
            ShowMessage($"Relay {r.Name} saved", "success");
        }
        catch (Exception ex)
        {
            relayError = ex.Message;
        }
    }

