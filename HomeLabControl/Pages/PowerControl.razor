@page "/powercontrol"
@attribute [Authorize(Policy = Policies.PowerView)]
@inject HlcAuth Auth
@inject UserService Users
@using HomeLabControl.Services
@using HomeLabControl.Models
@using HostModel = HomeLabControl.Models.Host
@inject PowerControlService PowerService
@inject HlcConfigService ConfigService
@inject ILogger<PowerControl> Logger
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">
        <i class="bi bi-power"></i> Power Control
    </h3>
</div>


@if (!string.IsNullOrEmpty(message))
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        <div class="toast show align-items-center text-white @GetToastClass() border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">@message</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="ClearMessage"></button>
            </div>
        </div>
    </div>
}

<!-- Desktop: Table -->
<div class="d-none d-lg-block table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Status / Name</th>
                <th>IP</th>
                <th>MAC</th>
                <th>Control</th>
                <th>Countdown</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var host in hosts)
            {
                var hostName = host.Name;
                <tr>
                    <td>
                        <span style="color: @(host.IsOnline ? "#28a745" : "#dc3545");">●</span>
                        <a href="host/@host.Name" class="link-body-emphasis" style="margin-left: 8px;">@host.Name</a>
                    </td>
                    <td>
                        <a href="http://@host.Ip:@host.Port/" target="_blank" class="text-decoration-none">@host.Ip</a>
                    </td>
                    <td>@host.Mac</td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <button class="btn btn-sm btn-primary" disabled="@(!canControl || string.IsNullOrWhiteSpace(host.Mac))" @onclick="() => Wol(host.Mac!)">WOL</button>

                            <input type="number" @bind="delayValues[hostName]" min="0" max="3600"
                                   style="width: 80px;" class="form-control form-control-sm">

                            <button class="btn btn-sm btn-warning" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Shutdown(host.Ip, host.Port, hostName, false)">
                                Shutdown
                            </button>
                            <button class="btn btn-sm btn-warning" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Shutdown(host.Ip, host.Port, hostName, true)">
                                Shutdown Dialog
                            </button>
                            <button class="btn btn-sm btn-info" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Reboot(host.Ip, host.Port, hostName, false)">
                                Reboot
                            </button>
                            <button class="btn btn-sm btn-info" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Reboot(host.Ip, host.Port, hostName, true)">
                                Reboot Dialog
                            </button>
                            <button class="btn btn-sm btn-danger" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Cancel(host.Ip, host.Port, hostName)">
                                Cancel
                            </button>
                        </div>
                    </td>
                    <td>
                        @if (countdowns.ContainsKey(hostName) && countdowns[hostName] > 0)
                        {
                            <span class="badge bg-warning">@countdowns[hostName]s</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile/Tablet: Cards -->
<div class="d-lg-none">
    @foreach (var host in hosts)
    {
        var hostName = host.Name;
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">
                        <span style="color: @(host.IsOnline ? "#28a745" : "#dc3545");">●</span>
                        <a href="host/@host.Name" class="link-body-emphasis">@host.Name</a>
                    </h5>
                </div>

                <p class="mb-2">
                    <small class="text-muted">IP:</small>
                    <a href="http://@host.Ip:@host.Port/" target="_blank">@host.Ip</a><br>
                    <small class="text-muted">MAC:</small> @host.Mac
                </p>

                <div class="mb-3">
                    <label class="form-label mb-1"><small>Delay (seconds)</small></label>
                    <input type="number" @bind="delayValues[hostName]" min="0" max="3600" class="form-control">
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary" disabled="@(!canControl || string.IsNullOrWhiteSpace(host.Mac))" @onclick="() => Wol(host.Mac!)">WOL</button>
                    <button class="btn btn-warning" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Shutdown(host.Ip, host.Port, hostName, false)">
                        Shutdown
                    </button>
                    <button class="btn btn-warning" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Shutdown(host.Ip, host.Port, hostName, true)">
                        Shutdown Dialog
                    </button>
                    <button class="btn btn-info" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Reboot(host.Ip, host.Port, hostName, false)">
                        Reboot
                    </button>
                    <button class="btn btn-info" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Reboot(host.Ip, host.Port, hostName, true)">
                        Reboot Dialog
                    </button>
                    <button class="btn btn-danger" disabled="@(!canControl || !host.HasAgent)" title="@(host.HasAgent ? null : "no agent on this host")" @onclick="() => Cancel(host.Ip, host.Port, hostName)">
                        Cancel
                    </button>
                </div>

                @if (countdowns.ContainsKey(hostName) && countdowns[hostName] > 0)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        <small>Countdown: @countdowns[hostName]s</small>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ─── Группы ──────────────────────────────────────────────────────────── *@
@if (groups.Count > 0 || isAdmin)
{
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h5 class="mb-0"><i class="bi bi-collection"></i> Groups</h5>
        @if (isAdmin)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="NewGroup"><i class="bi bi-plus-lg"></i> New group</button>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 15%">Group</th>
                    <th>Hosts</th>
                    <th style="width: 10%">Online</th>
                    <th class="text-end" style="width: 1%">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (groups.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center py-3">
                            No groups yet. A group gets <b>WOL all</b> / <b>Shutdown all</b> buttons here and can be a target in Automation.
                        </td>
                    </tr>
                }
                @foreach (var (name, members) in groups)
                {
                    <tr @key="name">
                        <td><b>@name</b></td>
                        <td>
                            @foreach (var m in members)
                            {
                                <span class="badge rounded-pill @(m.IsOnline ? "text-bg-success" : "text-bg-secondary") me-1">@m.Name</span>
                            }
                        </td>
                        <td>@members.Count(m => m.IsOnline) of @members.Count</td>
                        <td class="text-end text-nowrap">
                            @if (confirmGroup == name)
                            {
                                <span class="small me-2">Shut down @members.Count(m => m.HasAgent && m.IsOnline) online host(s)?</span>
                                <button class="btn btn-sm btn-danger me-1" @onclick="() => GroupShutdown(name)">Yes</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => confirmGroup = null">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary me-1" disabled="@(!canControl || members.All(m => string.IsNullOrWhiteSpace(m.Mac)))"
                                        @onclick="() => GroupWol(name)">WOL all</button>
                                <button class="btn btn-sm btn-warning me-1" disabled="@(!canControl || members.All(m => !m.HasAgent))"
                                        @onclick="() => confirmGroup = name">Shutdown all</button>
                                @if (isAdmin)
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Edit" @onclick="() => EditGroup(name)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => DeleteGroup(name)"><i class="bi bi-trash"></i></button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ─── Окно группы (админ) ─────────────────────────────────────────────── *@
@if (groupEdit != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(groupEdit.Original == null ? "New group" : $"Edit group {groupEdit.Original}")</h5>
                    <button type="button" class="btn-close" @onclick="() => groupEdit = null"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="groupEdit.Name" placeholder="e.g. lab" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label d-block">Hosts</label>
                        <TargetPicker Selected="groupEdit.Members" Hosts="PowerService.GetHosts().Select(h => h.Name).ToList()" Placeholder="choose hosts…" Block="true" />
                    </div>
                    @if (groupError != null)
                    {
                        <div class="alert alert-danger small mt-3 mb-0" style="white-space: pre-line">@groupError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => groupEdit = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveGroup">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Права на управление: кнопки выключены без них, обработчики дополнительно проверяют через Auth.RequireAsync
    private bool canControl;

    // Для фильтра хостов (права пользователя по хостам)
    private HlcUser? currentUser;

    protected override async Task OnParametersSetAsync()
    {
        canControl = await Auth.CanAsync(Policies.PowerControl);
        isAdmin = await Auth.CanAsync(Policies.Admin);
        currentUser = Users.Find(await Auth.GetUserNameAsync());
        LoadData();
    }

    private List<HostModel> hosts = new();
    private PowerControlSettings settings = new();
    private Dictionary<string, int> delayValues = new();
    private Dictionary<string, int> countdowns = new();
    private Dictionary<string, System.Threading.Timer?> countdownTimers = new();

    private string message = "";
    private string messageType = "";

    private System.Threading.Timer? updateTimer;



    // ─── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        LoadData();
        StartUpdateTimer();
    }

    private void StartUpdateTimer()
    {
        updateTimer = new System.Threading.Timer(_ =>
        {
            LoadData();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void LoadData()
    {
        hosts = PowerService.GetHosts().Where(h => HlcAuth.HostAllowed(currentUser, h.Name)).ToList();

        // Группа видна, только если все её хосты доступны пользователю
        groups = new();
        foreach (var (name, _) in ConfigService.GetGroups())
        {
            var members = ConfigService.ResolveTargets(new[] { name }, out _)
                .Select(m => hosts.FirstOrDefault(h => h.Name == m.Name)).ToList();
            if (members.Count > 0 && members.All(m => m != null))
                groups.Add((name, members.Select(m => m!).ToList()));
        }
        settings = PowerService.GetSettings();

        // Initialize default delay values
        foreach (var host in hosts)
        {
            if (!delayValues.ContainsKey(host.Name))
            {
                delayValues[host.Name] = host.DefaultDelaySeconds ?? settings.DefaultDelaySeconds;
            }
        }
    }

    public void Dispose()
    {
        updateTimer?.Dispose();
        foreach (var timer in countdownTimers.Values)
        {
            timer?.Dispose();
        }
    }

    // ─── Config Editor ────────────────────────────────────────────────────────


    // ─── Группы ───────────────────────────────────────────────────────────────

    private List<(string Name, List<HostModel> Members)> groups = new();
    private string? confirmGroup;
    private bool isAdmin;

    // Редактор группы
    private class GroupEdit
    {
        public string? Original { get; init; }
        public string Name { get; set; } = "";
        public List<string> Members { get; set; } = new();
    }

    private GroupEdit? groupEdit;
    private string? groupError;

    private void NewGroup()
    {
        groupError = null;
        groupEdit = new GroupEdit();
    }

    private void EditGroup(string name)
    {
        groupError = null;
        var members = ConfigService.GetGroups().TryGetValue(name, out var list) ? list.ToList() : new List<string>();
        groupEdit = new GroupEdit { Original = name, Name = name, Members = members };
    }

    private async Task SaveGroup()
    {
        await Auth.RequireAsync(Policies.Admin);
        groupError = null;

        var g = groupEdit!;
        g.Name = g.Name.Trim();
        if (string.IsNullOrEmpty(g.Name))
        {
            groupError = "Name is required";
            return;
        }
        if (ConfigService.GetGroups().Keys.Any(k => k.Equals(g.Name, StringComparison.OrdinalIgnoreCase) &&
                                                   !k.Equals(g.Original ?? "", StringComparison.OrdinalIgnoreCase)))
        {
            groupError = $"Group {g.Name} already exists";
            return;
        }
        if (g.Members.Count == 0)
        {
            groupError = "Choose at least one host";
            return;
        }

        try
        {
            await ConfigService.SaveGroupAsync(g.Original, g.Name, g.Members);
            await Auth.AuditAsync("power.group.save", g.Name, string.Join(", ", g.Members));
            groupEdit = null;
            LoadData();
            ShowMessage($"Group {g.Name} saved", "success");
        }
        catch (Exception ex)
        {
            groupError = ex.Message;
        }
    }

    private async Task DeleteGroup(string name)
    {
        await Auth.RequireAsync(Policies.Admin);
        try
        {
            await ConfigService.DeleteGroupAsync(name);
            await Auth.AuditAsync("power.group.delete", name);
            LoadData();
            ShowMessage($"Group {name} deleted", "success");
        }
        catch (Exception ex)
        {
            // Например, группа используется в задаче автоматизации
            ShowMessage(ex.Message, "error");
        }
    }

    private List<HostModel> GroupMembers(string name)
        => groups.FirstOrDefault(g => g.Name == name).Members ?? new List<HostModel>();

    private async Task GroupWol(string name)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        var members = GroupMembers(name);
        foreach (var m in members)
            await Auth.RequireHostAsync(m.Name);

        var sent = 0;
        foreach (var m in members.Where(m => !string.IsNullOrWhiteSpace(m.Mac)))
        {
            if (await PowerService.WakeOnLanAsync(m.Mac!))
                sent++;
        }

        await Auth.AuditAsync("power.wol", name, $"group: {string.Join(", ", members.Select(m => m.Name))}", sent > 0);
        ShowMessage($"WOL sent to {sent} host(s) of {name}", sent > 0 ? "success" : "error");
    }

    private async Task GroupShutdown(string name)
    {
        confirmGroup = null;
        await Auth.RequireAsync(Policies.PowerControl);
        var members = GroupMembers(name);
        foreach (var m in members)
            await Auth.RequireHostAsync(m.Name);

        // Выключаем только включённые хосты с агентом; задержка — своя у каждого хоста
        var ok = new List<string>();
        var failed = new List<string>();
        foreach (var m in members.Where(m => m.HasAgent && m.IsOnline))
        {
            var delay = delayValues.TryGetValue(m.Name, out var d) ? d : m.DefaultDelaySeconds ?? settings.DefaultDelaySeconds;
            if (await PowerService.ShutdownAsync(m.Ip, m.Port, delay, false))
            {
                ok.Add(m.Name);
                StartCountdown(m.Name, delay);
            }
            else
            {
                failed.Add(m.Name);
            }
        }

        await Auth.AuditAsync("power.shutdown", name, $"group: ok [{string.Join(", ", ok)}], failed [{string.Join(", ", failed)}]", failed.Count == 0);
        ShowMessage(failed.Count == 0
                ? $"Shutdown initiated for {ok.Count} host(s) of {name}"
                : $"Shutdown of {name}: failed for {string.Join(", ", failed)}",
            failed.Count == 0 ? "success" : "error");
    }

    // ─── Power Control Actions ────────────────────────────────────────────────

    private async Task Wol(string mac)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        var host = PowerService.GetHosts().FirstOrDefault(h => string.Equals(h.Mac, mac, StringComparison.OrdinalIgnoreCase));
        await Auth.RequireHostAsync(host?.Name ?? mac);
        var success = await PowerService.WakeOnLanAsync(mac);
        await Auth.AuditAsync("power.wol", host?.Name ?? mac, null, success);
        ShowMessage(
            success ? "WOL packet sent" : "WOL failed",
            success ? "success" : "error");
    }

    private async Task Shutdown(string ip, int port, string hostName, bool withDialog)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        await Auth.RequireHostAsync(hostName);
        var delay = delayValues[hostName];
        var success = await PowerService.ShutdownAsync(ip, port, delay, withDialog);
        await Auth.AuditAsync("power.shutdown", hostName, $"delay={delay}s{(withDialog ? ", dialog" : "")}", success);

        if (success)
        {
            StartCountdown(hostName, delay);
            ShowMessage($"Shutdown initiated for {hostName}", "success");
        }
        else
        {
            ShowMessage($"Shutdown failed for {hostName}", "error");
        }
    }

    private async Task Reboot(string ip, int port, string hostName, bool withDialog)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        await Auth.RequireHostAsync(hostName);
        var delay = delayValues[hostName];
        var success = await PowerService.RebootAsync(ip, port, delay, withDialog);
        await Auth.AuditAsync("power.reboot", hostName, $"delay={delay}s{(withDialog ? ", dialog" : "")}", success);

        if (success)
        {
            StartCountdown(hostName, delay);
            ShowMessage($"Reboot initiated for {hostName}", "success");
        }
        else
        {
            ShowMessage($"Reboot failed for {hostName}", "error");
        }
    }

    private async Task Cancel(string ip, int port, string hostName)
    {
        await Auth.RequireAsync(Policies.PowerControl);
        await Auth.RequireHostAsync(hostName);
        var success = await PowerService.CancelAsync(ip, port);
        await Auth.AuditAsync("power.cancel", hostName, null, success);

        if (success)
        {
            StopCountdown(hostName);
            ShowMessage("Cancelled", "info");
        }
        else
        {
            ShowMessage("Cancel failed", "error");
        }
    }

    // ─── Countdown Timer ──────────────────────────────────────────────────────

    private void StartCountdown(string hostName, int seconds)
    {
        StopCountdown(hostName);
        countdowns[hostName] = seconds;

        countdownTimers[hostName] = new System.Threading.Timer(_ =>
        {
            if (countdowns.ContainsKey(hostName) && countdowns[hostName] > 0)
            {
                countdowns[hostName]--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                StopCountdown(hostName);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopCountdown(string hostName)
    {
        if (countdownTimers.ContainsKey(hostName) && countdownTimers[hostName] != null)
        {
            countdownTimers[hostName]?.Dispose();
            countdownTimers[hostName] = null;
        }

        if (countdowns.ContainsKey(hostName))
        {
            countdowns[hostName] = 0;
        }
    }

    // ─── Toast Messages ───────────────────────────────────────────────────────

    private void ShowMessage(string msg, string type)
    {
        message = msg;
        messageType = type;
        StateHasChanged();

        Task.Delay(3000).ContinueWith(_ =>
        {
            message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private void ClearMessage() => message = "";

    private string GetToastClass() => messageType switch
    {
        "success" => "bg-success",
        "error" => "bg-danger",
        "info" => "bg-info",
        _ => "bg-secondary"
    };
}
