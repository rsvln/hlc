    private List<WolRelay> relays = new();
    private WolRelay? relayEdit;
    private string? relayEditOriginal;
    private string? relayError;
    private string? testingRelay;
    private WolRelay? setupRelay;
    private string? setupPassword;
    private DeployResult? setupResult;
