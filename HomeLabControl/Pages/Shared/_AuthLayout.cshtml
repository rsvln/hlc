<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HomeLabControl</title>
    <base href="~/" />
    <script src="js/theme.js"></script>
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-body-tertiary">
    <div class="d-flex align-items-center justify-content-center min-vh-100 p-3">
        <div class="card shadow" style="width: 100%; max-width: 380px;">
            <div class="card-body p-4">
                <h4 class="mb-4 text-center"><i class="bi bi-house-gear"></i> HomeLabControl</h4>
                @RenderBody()
            </div>
            <div class="card-footer text-center small text-muted">v@(HomeLabControl.VersionInfo.Version)</div>
        </div>
    </div>
</body>
</html>
